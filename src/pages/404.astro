---
import Layout from '../layouts/Layout.astro';
import { ruta } from '../utils/rutas';
---

<Layout titulo="Página no encontrada">
  <section class="seccion centro">
    <div class="contenedor">
      <p class="etiqueta">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="apagado">Puede que el enlace esté roto o que la página se haya movido.</p>
      <p><a class="boton" href={ruta("/")}>Volver al inicio</a></p>
    </div>
  </section>
</Layout>

<style>
  .centro { text-align: center; padding-block: clamp(4rem, 12vw, 8rem); }
</style>
