---
import { perfil } from '../data/perfil';
const anio = new Date().getFullYear();
---

<footer>
  <div class="contenedor fila">
    <p class="apagado">© {anio} {perfil.nombre}. Hecho con Astro.</p>
    <ul>
      <li><a href={`mailto:${perfil.email}`}>Email</a></li>
      <li><a href={perfil.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      {
        perfil.linkedin && (
          <li>
            <a href={perfil.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--borde);
    padding-block: 2rem;
    margin-top: 3rem;
  }

  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  p { margin: 0; font-size: 0.88rem; }

  ul {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
  }
</style>
