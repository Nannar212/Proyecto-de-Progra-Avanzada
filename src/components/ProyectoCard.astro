---
import type { Proyecto } from '../data/proyectos';
import { ruta } from '../utils/rutas';

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
---

<article class="tarjeta" data-curso={proyecto.curso}>
  <a class="enlace-cubierta" href={ruta(`/proyectos/${proyecto.slug}`)}>
    <span class="sr-only">Ver {proyecto.titulo}</span>
  </a>

  <div class="portada" aria-hidden="true">{proyecto.icono ?? '📁'}</div>

  <div class="cuerpo">
    <p class="etiqueta">{proyecto.curso} · {proyecto.periodo}</p>
    <h3>{proyecto.titulo}</h3>
    <p class="apagado resumen">{proyecto.resumen}</p>

    <ul class="chips">
      {proyecto.tecnologias.slice(0, 4).map((t) => <li class="chip">{t}</li>)}
    </ul>

    <div class="pie">
      <span class="ver">Ver detalle →</span>
      {
        proyecto.repo && (
          <a class="externo" href={proyecto.repo} target="_blank" rel="noopener noreferrer">
            Código
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--fondo-alt);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .tarjeta:hover {
    transform: translateY(-3px);
    border-color: var(--acento);
    box-shadow: var(--sombra);
  }

  .enlace-cubierta {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .portada {
    display: grid;
    place-items: center;
    height: 7.5rem;
    font-size: 2.6rem;
    background: var(--acento-suave);
    border-bottom: 1px solid var(--borde);
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.2rem;
    flex: 1;
  }

  .etiqueta { margin: 0; }
  h3 { margin: 0; }
  .resumen { margin: 0; font-size: 0.92rem; flex: 1; }

  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    font-size: 0.88rem;
  }

  .ver { color: var(--acento); font-weight: 550; }

  /* Por encima del enlace que cubre la tarjeta, para que sea clicable. */
  .externo {
    position: relative;
    z-index: 2;
    color: var(--texto-suave);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
