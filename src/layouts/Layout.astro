---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = `${perfil.nombre} — Portafolio`,
  descripcion = `Portafolio de ${perfil.nombre}. Proyectos universitarios de desarrollo de software.`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Aplica el tema antes de pintar para evitar el parpadeo.
      (() => {
        try {
          const guardado = localStorage.getItem('tema');
          const oscuro = guardado
            ? guardado === 'oscuro'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.tema = oscuro ? 'oscuro' : 'claro';
        } catch {
          document.documentElement.dataset.tema = 'claro';
        }
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --fondo: #fbfaf8;
    --fondo-alt: #ffffff;
    --borde: #e5e1da;
    --texto: #1c1a17;
    --texto-suave: #6b6459;
    --acento: #b4532a;
    --acento-suave: #f4e6df;
    --sombra: 0 1px 2px rgb(28 26 23 / 0.05), 0 8px 24px -12px rgb(28 26 23 / 0.12);
    --radio: 14px;
    --ancho: 1080px;
    --fuente: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    color-scheme: light;
  }

  :root[data-tema='oscuro'] {
    --fondo: #14130f;
    --fondo-alt: #1c1b16;
    --borde: #302d25;
    --texto: #f2efe9;
    --texto-suave: #a29a8b;
    --acento: #e08a5c;
    --acento-suave: #2b2019;
    --sombra: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px -12px rgb(0 0 0 / 0.6);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    font-family: var(--fuente);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.5em;
    font-weight: 650;
  }

  h1 { font-size: clamp(2.1rem, 5.5vw, 3.4rem); }
  h2 { font-size: clamp(1.5rem, 3.2vw, 2rem); }
  h3 { font-size: 1.15rem; }

  p { margin: 0 0 1rem; }

  a {
    color: var(--acento);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  main { min-height: 60vh; }

  .contenedor {
    width: 100%;
    max-width: var(--ancho);
    margin-inline: auto;
    padding-inline: clamp(1.15rem, 5vw, 2rem);
  }

  .seccion { padding-block: clamp(3rem, 8vw, 5.5rem); }

  .seccion-titulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .etiqueta {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-bottom: 0.6rem;
  }

  .apagado { color: var(--texto-suave); }

  .chip {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--borde);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--texto-suave);
    background: var(--fondo-alt);
    white-space: nowrap;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--acento);
    background: var(--acento);
    color: #fff;
    font-weight: 550;
    font-size: 0.92rem;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .boton:hover { transform: translateY(-1px); opacity: 0.92; }

  .boton.fantasma {
    background: transparent;
    color: var(--texto);
    border-color: var(--borde);
  }

  :focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--acento);
    color: #fff;
    padding: 0.6rem 1rem;
    z-index: 100;
  }
  .saltar:focus { left: 0; }
</style>
